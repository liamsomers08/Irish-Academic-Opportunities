  if(!def){result.reason='Unsupported review kind';return result;}if(!stage9ReviewIssueEligible_(review.issueType)){result.reason='Issue type is intentionally not auto-written';return result;}
  const record=stage9FindMasterRecord_(ss,def,review.opportunityId);if(!record){result.reason='Master record not found';return result;}const sourceUrl=review.sourceUrl||stage9FirstHeaderValue_(record.rowValues,record.headers,def.sourceHeaders);if(!sourceUrl){result.reason='No official/current source stored';return result;}
  const fetched=stage9FetchSource_(sourceUrl);if(!fetched.ok){result.sourceInaccessible=true;result.error=true;result.reason=fetched.reason;return result;}const contextInfo=stage9OpportunityContext_(fetched.text,record.name,sourceUrl);if(contextInfo.relevance<0.30){result.reason='Official source was readable but did not contain enough opportunity-specific context';return result;}
  const statusCandidate=policy.autoStatuses?stage9StatusCandidate_(def,record,contextInfo,sourceUrl,review):null;if(statusCandidate){if(stage9Equivalent_(statusCandidate.oldValue,statusCandidate.newValue))result.explicitMatches=true;else result.candidates.push(statusCandidate);}
  if(policy.autoDates)def.dateRules.forEach(function(rule){const candidate=stage9DateCandidate_(def,record,rule,contextInfo,sourceUrl,review);if(!candidate)return;if(stage9EquivalentDate_(candidate.oldValue,candidate.newValue))result.explicitMatches=true;else result.candidates.push(candidate);});
  if(!result.candidates.length&&!result.explicitMatches)result.reason='No unambiguous green-rule status/date value was found on the official source';return result;
}
function stage9StatusCandidate_(def,record,contextInfo,sourceUrl,review){
  const context=contextInfo.context.toLowerCase(),closedSignals=['applications are now closed','applications are closed','applications have now closed','applications have closed','entries are now closed','entries are closed','registration is now closed','registration is closed','submissions are now closed','submissions are closed','no longer accepting applications','deadline has passed'],openSignals=['applications are now open','applications are open','applications are currently open','now accepting applications','entries are now open','entries are open','registration is now open','registration is open'],closed=stage9FirstSignal_(context,closedSignals),open=stage9FirstSignal_(context,openSignals);if((!closed&&!open)||(closed&&open))return null;
  const col=stage9FindHeader_(record.headers,[def.statusHeader]);if(col<0||record.formulas[col])return null;const newValue=closed?def.closedValue:def.openValue;let confidence=contextInfo.baseScore+50+15;confidence=Math.min(100,confidence);if(confidence<STAGE9_CONFIG.AUTO_CONFIDENCE_THRESHOLD)return null;
  return {key:def.master+'!'+record.rowNumber+'!'+(col+1),kind:def.key,sheet:def.master,row:record.rowNumber,col:col+1,opportunityId:record.id,opportunityName:record.name,field:def.statusHeader,oldValue:record.rowValues[col],newValue:newValue,confidence:confidence,sourceUrl:sourceUrl,evidence:'Explicit status signal: “'+(closed||open)+'”',reviewIds:[review.reviewId]};
}
function stage9DateCandidate_(def,record,rule,contextInfo,sourceUrl,review){const extracted=stage9ExtractUniqueDate_(contextInfo.context,rule.labels);if(!extracted)return null;const col=stage9FindHeader_(record.headers,[rule.field]);if(col<0||record.formulas[col])return null;let confidence=contextInfo.baseScore+40+15+(stage9PlausibleCycleDate_(extracted.date)?10:0);confidence=Math.min(100,confidence);if(confidence<STAGE9_CONFIG.AUTO_CONFIDENCE_THRESHOLD)return null;return {key:def.master+'!'+record.rowNumber+'!'+(col+1),kind:def.key,sheet:def.master,row:record.rowNumber,col:col+1,opportunityId:record.id,opportunityName:record.name,field:rule.field,oldValue:record.rowValues[col],newValue:extracted.date,confidence:confidence,sourceUrl:sourceUrl,evidence:'Exact labelled date: '+extracted.label+' → '+stage9FormatDate_(extracted.date)+'; source context: '+extracted.snippet,reviewIds:[review.reviewId]};}

function stage9ApplyWithRegression_(ss,candidates,runId,policy){
  if(!candidates.length)return {ok:true,applied:[],rolledBack:false,gate:{pass:true,detail:'No field writes required'}};const snapshots=[],applied=[];
  try{candidates.forEach(function(candidate){const sheet=ss.getSheetByName(candidate.sheet);if(!sheet)throw new Error('Missing master sheet '+candidate.sheet);const cell=sheet.getRange(candidate.row,candidate.col),oldFormula=cell.getFormula();if(oldFormula)return;snapshots.push({sheet:candidate.sheet,row:candidate.row,col:candidate.col,value:cell.getValue(),formula:oldFormula,numberFormat:cell.getNumberFormat()});cell.setValue(candidate.newValue);applied.push(candidate);});SpreadsheetApp.flush();const gate=policy.regressionGate?stage9RegressionGate_(ss):{pass:true,detail:'Regression gate disabled by policy'};if(!gate.pass){stage9Rollback_(ss,snapshots);stage9WriteChangeLog_(ss,applied,runId,'ROLLED BACK',gate.detail);return {ok:false,applied:applied,rolledBack:true,gate:gate};}stage9WriteChangeLog_(ss,applied,runId,'APPLIED',gate.detail);return {ok:true,applied:applied,rolledBack:false,gate:gate};}
  catch(err){stage9Rollback_(ss,snapshots);const gate={pass:false,detail:'Runtime error: '+stage9ShortError_(err)};stage9WriteChangeLog_(ss,applied,runId,'ROLLED BACK',gate.detail);return {ok:false,applied:applied,rolledBack:true,gate:gate};}
}
function stage9Rollback_(ss,snapshots){snapshots.slice().reverse().forEach(function(s){const cell=ss.getSheetByName(s.sheet).getRange(s.row,s.col);if(s.formula)cell.setFormula(s.formula);else cell.setValue(s.value);if(s.numberFormat)cell.setNumberFormat(s.numberFormat);});SpreadsheetApp.flush();}
function stage9RegressionGate_(ss){
  SpreadsheetApp.flush();const failures=[],regression=ss.getSheetByName(STAGE9_CONFIG.SHEETS.regression);if(!regression||regression.getLastRow()<2)failures.push('Regression test sheet missing');else{const rows=regression.getRange(2,1,regression.getLastRow()-1,Math.min(3,regression.getLastColumn())).getDisplayValues();rows.forEach(function(r){if(String(r[0]||'').trim()&&String(r[1]||'').trim().toUpperCase()!=='PASS')failures.push(String(r[0])+'='+String(r[1]||'blank'));});}
  const admin=ss.getSheetByName(STAGE9_CONFIG.SHEETS.admin);if(!admin)failures.push('Admin dashboard missing');else{const values=admin.getRange(1,1,Math.min(admin.getLastRow(),80),Math.min(admin.getLastColumn(),3)).getDisplayValues(),metrics={};values.forEach(function(r){if(r[0])metrics[stage9Canon_(r[0])]=String(r[1]||'');});[['dataqualityissues','Data quality issues'],['regressionfailures','Regression failures'],['regressionwarnings','Regression warnings'],['expectedresearchedrecordsstillmissing','Expected researched records still missing']].forEach(function(pair){if(metrics[pair[0]]!==undefined&&Number(metrics[pair[0]]||0)!==0)failures.push(pair[1]+'='+metrics[pair[0]]);});}
  return {pass:failures.length===0,detail:failures.length?'FAIL: '+failures.join('; '):'PASS: regression and data-quality gates clear'};
}

function stage9SelectReviews_(sheet,limit,retryDeferredDays){const width=Math.min(12,sheet.getLastColumn()),values=sheet.getRange(1,1,sheet.getLastRow(),width).getValues(),headers=stage9HeaderMap_(values[0]),c={id:stage9FindHeader_(headers,['Review ID']),detected:stage9FindHeader_(headers,['Detected At']),kind:stage9FindHeader_(headers,['Kind']),oppId:stage9FindHeader_(headers,['Opportunity ID']),name:stage9FindHeader_(headers,['Opportunity Name']),issue:stage9FindHeader_(headers,['Issue Type']),source:stage9FindHeader_(headers,['Source URL']),status:stage9FindHeader_(headers,['Review Status']),lastSeen:stage9FindHeader_(headers,['Last Seen'])},now=Date.now(),retryMs=retryDeferredDays*86400000,out=[];values.slice(1).forEach(function(row,i){const status=c.status>=0?String(row[c.status]||'').trim():'New',last=stage9DateMs_(c.lastSeen>=0?row[c.lastSeen]:'');if(!(/^new$/i.test(status)||(/^deferred$/i.test(status)&&(!last||now-last>=retryMs))))return;const issue=c.issue>=0?String(row[c.issue]||''):'';if(!stage9ReviewIssueEligible_(issue))return;out.push({row:i+2,reviewId:c.id>=0?String(row[c.id]||''):Utilities.getUuid(),detectedAt:c.detected>=0?row[c.detected]:'',kind:c.kind>=0?String(row[c.kind]||'').toLowerCase():'',opportunityId:c.oppId>=0?String(row[c.oppId]||''):'',opportunityName:c.name>=0?String(row[c.name]||''):'',issueType:issue,sourceUrl:c.source>=0?String(row[c.source]||''):''});});out.sort(function(a,b){return stage9DateMs_(a.detectedAt)-stage9DateMs_(b.detectedAt);});return out.slice(0,limit);}
function stage9ReviewIssueEligible_(issue){const s=String(issue||'').toLowerCase();if(/source content changed|page content changed|open status after stored deadline|master status needs review/.test(s))return true;if(/^feedback:/.test(s)&&/deadline|date|discontinued|closed|open/.test(s))return true;return false;}
function stage9FindMasterRecord_(ss,def,id){const sheet=ss.getSheetByName(def.master);if(!sheet||sheet.getLastRow()<2||!id)return null;const range=sheet.getDataRange(),values=range.getValues(),formulas=range.getFormulas(),headers=stage9HeaderMap_(values[0]),idCol=stage9FindHeader_(headers,[def.idHeader]),nameCol=stage9FindHeader_(headers,[def.nameHeader]);if(idCol<0)return null;for(let i=1;i<values.length;i++)if(String(values[i][idCol]||'').trim()===String(id).trim())return {sheet:sheet,headers:headers,rowValues:values[i],formulas:formulas[i],rowNumber:i+1,id:String(values[i][idCol]||''),name:nameCol>=0?String(values[i][nameCol]||''):String(id)};return null;}
function stage9FetchSource_(url){try{const response=UrlFetchApp.fetch(String(url),{method:'get',followRedirects:true,muteHttpExceptions:true,headers:{'User-Agent':STAGE9_CONFIG.USER_AGENT,'Accept':'text/html,application/xhtml+xml,*/*;q=0.6','Accept-Language':'en-IE,en;q=0.9'}}),code=Number(response.getResponseCode()||0);if(code<200||code>=400)return {ok:false,reason:'HTTP '+code};let body='';try{body=response.getContentText()||'';}catch(_){body='';}const text=stage9ReadableText_(body);if(text.length<STAGE9_CONFIG.MIN_READABLE_CHARS)return {ok:false,reason:'too little readable content ('+text.length+' chars)'};return {ok:true,code:code,text:text,html:body};}catch(err){return {ok:false,reason:stage9ShortError_(err)};}}
function stage9OpportunityContext_(text,name,url){const clean=String(text||''),tokens=stage9NameTokens_(name),lower=clean.toLowerCase();let hits=0,firstIndex=-1;tokens.forEach(function(token){const idx=lower.indexOf(token);if(idx>=0){hits++;if(firstIndex<0||idx<firstIndex)firstIndex=idx;}});const denom=Math.max(1,Math.min(tokens.length,6)),relevance=Math.min(1,hits/denom);let context=clean;if(firstIndex>=0)context=clean.slice(Math.max(0,firstIndex-1000),Math.min(clean.length,firstIndex+5000));let deep=false;try{const m=String(url||'').match(/^https?:\/\/[^/]+(\/[^?#]*)?/i),p=String(m&&m[1]||'').replace(/^\/+|\/+$/g,'');deep=p.length>=5&&p.split('/').filter(Boolean).length>=1;}catch(_){}let baseScore=deep?15:5;if(relevance>=0.75)baseScore+=35;else if(relevance>=0.5)baseScore+=25;else if(relevance>=0.3)baseScore+=15;return {context:context,relevance:relevance,baseScore:baseScore,deep:deep};}
function stage9NameTokens_(name){const stop={young:1,student:1,students:1,international:1,ireland:1,irish:1,competition:1,contest:1,award:1,awards:1,programme:1,program:1,scholarship:1,scholarships:1,challenge:1,the:1,and:1,for:1,year:1},seen={};return String(name||'').toLowerCase().replace(/[^a-z0-9]+/g,' ').split(/\s+/).filter(function(t){if(t.length<4||stop[t]||seen[t])return false;seen[t]=true;return true;}).slice(0,10);}
function stage9FirstSignal_(text,signals){for(let i=0;i<signals.length;i++)if(text.indexOf(signals[i])>=0)return signals[i];return '';}
function stage9ExtractUniqueDate_(text,labels){const lower=String(text||'').toLowerCase(),found={};labels.forEach(function(label){let pos=0;while((pos=lower.indexOf(label.toLowerCase(),pos))>=0){const snippet=String(text).slice(pos,Math.min(String(text).length,pos+240));stage9DatesInText_(snippet).forEach(function(item){if(!stage9PlausibleCycleDate_(item.date))return;const key=Utilities.formatDate(item.date,STAGE9_CONFIG.TIMEZONE,'yyyy-MM-dd');found[key]={date:item.date,label:label,snippet:snippet.slice(0,220)};});pos+=label.length;}});const keys=Object.keys(found);return keys.length===1?found[keys[0]]:null;}
