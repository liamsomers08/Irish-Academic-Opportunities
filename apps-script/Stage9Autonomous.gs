function stage9WriteChangeLog_(ss,changes,runId,outcome,gate){const sheet=ss.getSheetByName(STAGE9_CONFIG.SHEETS.changeLog);if(!sheet)return;changes.forEach(function(c){sheet.appendRow([Utilities.getUuid(),new Date(),runId,c.kind,c.opportunityId,c.opportunityName,c.field,stage9DisplayValue_(c.oldValue),stage9DisplayValue_(c.newValue),c.confidence,c.sourceUrl,c.evidence,outcome,gate,(c.reviewIds||[]).join(',')]);});}
