function stage9EnsureSheets_(ss){let policy=ss.getSheetByName(STAGE9_CONFIG.SHEETS.policy);if(!policy){policy=ss.insertSheet(STAGE9_CONFIG.SHEETS.policy,Math.min(9,ss.getNumSheets()),{rows:40,columns:4});stage9SeedPolicy_(policy);}let log=ss.getSheetByName(STAGE9_CONFIG.SHEETS.changeLog);if(!log){log=ss.insertSheet(STAGE9_CONFIG.SHEETS.changeLog,ss.getNumSheets(),{rows:3000,columns:15});log.getRange(1,1,1,15).setValues([['Change ID','Applied At','Run ID','Kind','Opportunity ID','Opportunity Name','Field','Old Value','New Value','Confidence','Source URL','Evidence','Outcome','Regression Gate','Review IDs']]);stage9StyleHeader_(log,15);log.setFrozenRows(1);log.hideSheet();}}
function stage9SeedPolicy_(sheet){const rows=[['STAGE 9 AUTOMATION POLICY','Value','Meaning','Safety'],['Version',STAGE9_CONFIG.VERSION,'Runtime policy version','Informational'],['Enabled','Yes','Master switch for Stage 9','Set No for immediate kill switch'],['Auto apply green changes','Yes','Commit high-confidence status/date changes','Regression rollback remains mandatory by default'],['Auto statuses','Yes','Open/closed only when official source is explicit','Conflicting signals are never written'],['Auto dates','Yes','Only one exact labelled date is accepted','Ambiguous/numeric-only dates are not inferred'],['Regression gate','Yes','Rollback all Stage 9 writes if release checks fail','Recommended: keep Yes'],['Resolve explicit no-change','No','Close a review when managed fields explicitly match','No keeps non-managed changes visible for later review'],['Max review items per run',STAGE9_CONFIG.DEFAULT_REVIEW_LIMIT,'Bounded source fetches per run','Prevents execution overruns'],['Max master field writes per run',STAGE9_CONFIG.DEFAULT_WRITE_LIMIT,'Bounded automatic writes','Limits blast radius'],['Retry deferred after days',STAGE9_CONFIG.DEFAULT_RETRY_DEFERRED_DAYS,'Automatic retry cadence for ambiguous items','Deferred items are not forgotten'],['Green fields','Status; Registration Opens; Registration Deadline; Submission Deadline; Application Opens; Application Deadline; Programme Start Date; Programme End Date','May auto-write with confidence >= '+STAGE9_CONFIG.AUTO_CONFIDENCE_THRESHOLD,'Official source + opportunity context + one unambiguous value'],['Amber fields','Cost; application method; location; duration; access/selectivity; source URL','Monitor/queue only','Require stronger structured extraction before future auto-enable'],['Red fields','Eligibility; school years/age; award value/coverage; Finder Eligible; deletion/removal','Never auto-write in Stage 9','High consequence / interpretation-sensitive']];sheet.getRange(1,1,rows.length,4).setValues(rows);stage9StyleHeader_(sheet,4);sheet.setFrozenRows(1);sheet.setColumnWidths(1,1,210);sheet.setColumnWidths(2,1,260);sheet.setColumnWidths(3,1,390);sheet.setColumnWidths(4,1,360);sheet.getRange(1,1,rows.length,4).setWrap(true).setVerticalAlignment('top');}
function stage9StyleHeader_(sheet,width){sheet.getRange(1,1,1,width).setBackground('#1f4e78').setFontColor('#ffffff').setFontWeight('bold').setWrap(true);}
function stage9GetPolicy_(ss){const sheet=ss.getSheetByName(STAGE9_CONFIG.SHEETS.policy);if(!sheet)return {enabled:true,autoApply:true,autoStatuses:true,autoDates:true,regressionGate:true,resolveExplicitNoChange:false,reviewLimit:STAGE9_CONFIG.DEFAULT_REVIEW_LIMIT,writeLimit:STAGE9_CONFIG.DEFAULT_WRITE_LIMIT,retryDeferredDays:STAGE9_CONFIG.DEFAULT_RETRY_DEFERRED_DAYS};const values=sheet.getRange(1,1,Math.min(sheet.getLastRow(),30),2).getDisplayValues(),map={};values.forEach(function(r){map[stage9Canon_(r[0])]=r[1];});const yes=function(k,d){return map[k]===undefined?d:/^yes|true|on|enabled$/i.test(String(map[k]).trim());},num=function(k,d,min,max){const n=Number(map[k]);return isFinite(n)?Math.max(min,Math.min(max,Math.floor(n))):d;};return {enabled:yes('enabled',true),autoApply:yes('autoapplygreenchanges',true),autoStatuses:yes('autostatuses',true),autoDates:yes('autodates',true),regressionGate:yes('regressiongate',true),resolveExplicitNoChange:yes('resolveexplicitnochange',false),reviewLimit:num('maxreviewitemsperrun',STAGE9_CONFIG.DEFAULT_REVIEW_LIMIT,1,60),writeLimit:num('maxmasterfieldwritesperrun',STAGE9_CONFIG.DEFAULT_WRITE_LIMIT,1,30),retryDeferredDays:num('retrydeferredafterdays',STAGE9_CONFIG.DEFAULT_RETRY_DEFERRED_DAYS,1,30)};}
function stage9EnsureTrigger_(){const triggers=ScriptApp.getProjectTriggers(),existing=triggers.filter(function(t){return t.getHandlerFunction()==='stage9RunDaily';});if(!existing.length)ScriptApp.newTrigger('stage9RunDaily').timeBased().everyDays(1).atHour(STAGE9_CONFIG.DAILY_HOUR).nearMinute(STAGE9_CONFIG.DAILY_MINUTE).inTimezone(STAGE9_CONFIG.TIMEZONE).create();if(existing.length>1)existing.slice(1).forEach(function(t){ScriptApp.deleteTrigger(t);});return 'daily around '+String(STAGE9_CONFIG.DAILY_HOUR).padStart(2,'0')+':'+String(STAGE9_CONFIG.DAILY_MINUTE).padStart(2,'0')+' '+STAGE9_CONFIG.TIMEZONE;}
function stage9AutoBootstrap_(){try{const props=PropertiesService.getScriptProperties();if(props.getProperty('stage9_bootstrap_version')===STAGE9_CONFIG.VERSION)return;stage9EnsureTrigger_();props.setProperty('stage9_bootstrap_version',STAGE9_CONFIG.VERSION);}catch(err){console.log('Stage 9 bootstrap deferred: '+stage9ShortError_(err));}}

function stage9SetDashboardStatus_(value,health,action){const sheet=stage9Spreadsheet_().getSheetByName(STAGE9_CONFIG.SHEETS.dashboard);if(sheet)sheet.getRange('B3:D3').setValues([[value,health,action]]);}
function stage9AppendRunLog_(r){const sheet=stage9Spreadsheet_().getSheetByName(STAGE9_CONFIG.SHEETS.runLog);if(sheet)sheet.appendRow([new Date(),r.job||'',r.kind||'all',Number(r.checked||0),0,Number(r.changes||0),0,Number(r.errors||0),Number(r.reviewItems||0),Number(r.duration||0),r.notes||'']);}
function stage9Spreadsheet_(){return SpreadsheetApp.openById(STAGE9_CONFIG.SPREADSHEET_ID);}
function stage9HeaderMap_(headers){const out={};headers.forEach(function(h,i){out[stage9Canon_(h)]=i;});return out;}
function stage9Canon_(v){return String(v||'').toLowerCase().replace(/[^a-z0-9]/g,'');}
function stage9FindHeader_(map,names){for(let i=0;i<names.length;i++){const k=stage9Canon_(names[i]);if(Object.prototype.hasOwnProperty.call(map,k))return map[k];}return -1;}
function stage9FirstHeaderValue_(row,map,names){for(let i=0;i<names.length;i++){const c=stage9FindHeader_(map,[names[i]]);if(c>=0&&String(row[c]||'').trim())return String(row[c]).trim();}return '';}
function stage9DateMs_(v){if(v instanceof Date&&!isNaN(v.getTime()))return v.getTime();const d=new Date(v||0);return isNaN(d.getTime())?0:d.getTime();}
function stage9FormatDateTime_(d){return Utilities.formatDate(d,STAGE9_CONFIG.TIMEZONE,'d MMM yyyy HH:mm');}
function stage9FormatDate_(d){return Utilities.formatDate(d,STAGE9_CONFIG.TIMEZONE,'d MMMM yyyy');}
function stage9ShortError_(e){return String(e&&e.message?e.message:e||'Unknown error').slice(0,500);}
function stage9DisplayValue_(v){return v instanceof Date?stage9FormatDate_(v):String(v===null||v===undefined?'':v);}
function stage9Equivalent_(a,b){return stage9Canon_(stage9DisplayValue_(a))===stage9Canon_(stage9DisplayValue_(b));}
function stage9EquivalentDate_(a,b){const ad=stage9AsDate_(a),bd=stage9AsDate_(b);return !!ad&&!!bd&&Utilities.formatDate(ad,STAGE9_CONFIG.TIMEZONE,'yyyy-MM-dd')===Utilities.formatDate(bd,STAGE9_CONFIG.TIMEZONE,'yyyy-MM-dd');}
function stage9AsDate_(v){if(v instanceof Date&&!isNaN(v.getTime()))return v;const s=String(v||'').trim();if(!s||/\b(tba|tbc|unknown|varies)\b/i.test(s))return null;const arr=stage9DatesInText_(s);if(arr.length===1)return arr[0].date;const d=new Date(s);return isNaN(d.getTime())?null:d;}
function stage9ReadableText_(html){let s=String(html||'');s=s.replace(/<!--[\s\S]*?-->/g,' ').replace(/<(script|style|noscript|svg|iframe)[^>]*>[\s\S]*?<\/\1>/gi,' ').replace(/<br\s*\/?\s*>/gi,'\n').replace(/<\/(p|li|div|section|article|h1|h2|h3|h4|tr)>/gi,'\n').replace(/<[^>]+>/g,' ').replace(/&nbsp;|&#160;/gi,' ').replace(/&amp;/gi,'&').replace(/&quot;|&#34;/gi,'"').replace(/&#39;|&apos;/gi,"'").replace(/&lt;/gi,'<').replace(/&gt;/gi,'>').replace(/[ \t]+/g,' ').replace(/\n\s+/g,'\n').replace(/\n{3,}/g,'\n\n').trim();return s.slice(0,STAGE9_CONFIG.MAX_SOURCE_CHARS);}

