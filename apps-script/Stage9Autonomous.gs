  stage9SetDashboardStatus_('Installed','Active','Stage 9 autonomous maintenance is enabled; '+trigger+'.');
  stage9AppendRunLog_({job:'stage9-install',checked:0,changes:0,errors:0,reviewItems:0,notes:'Stage 9 '+STAGE9_CONFIG.VERSION+' installed. High-confidence auto-apply is enabled with regression rollback.'});
  return {ok:true,version:STAGE9_CONFIG.VERSION,trigger:trigger,policy:stage9GetPolicy_(ss)};
}
function stage9RunNow(){return stage9RunDaily();}
function stage9RunDaily(){
  const started=Date.now(),lock=LockService.getScriptLock();if(!lock.tryLock(5000))return {ok:false,skipped:true,reason:'Another Stage 9 run is active.'};
  try{
    const ss=stage9Spreadsheet_();stage9EnsureSheets_(ss);const policy=stage9GetPolicy_(ss);
    if(!policy.enabled){stage9AppendRunLog_({job:'autonomous-maintenance',checked:0,changes:0,errors:0,reviewItems:0,notes:'Skipped: Automation Policy is disabled.'});return {ok:true,skipped:true,reason:'disabled'};}
    const reviewSheet=ss.getSheetByName(STAGE9_CONFIG.SHEETS.review);
    if(!reviewSheet||reviewSheet.getLastRow()<2){stage9AppendRunLog_({job:'autonomous-maintenance',checked:0,changes:0,errors:0,reviewItems:0,notes:'No operations review items available.'});return {ok:true,checked:0,applied:0,deferred:0};}
    const reviews=stage9SelectReviews_(reviewSheet,policy.reviewLimit,policy.retryDeferredDays);
    if(!reviews.length){stage9AppendRunLog_({job:'autonomous-maintenance',checked:0,changes:0,errors:0,reviewItems:0,notes:'No eligible New/Deferred review items for Stage 9.'});stage9SetDashboardStatus_('Installed','Active','Last Stage 9 run: '+stage9FormatDateTime_(new Date())+' — no eligible review work.');return {ok:true,checked:0,applied:0,deferred:0};}
    const runId=Utilities.getUuid(),plans=[],outcomes=[];let fetchErrors=0;
    reviews.forEach(function(review){const result=stage9PlanReview_(ss,review,policy);outcomes.push(result);if(result.error)fetchErrors++;(result.candidates||[]).forEach(function(c){plans.push(c);});});
    const deduped=stage9DedupeCandidates_(plans).sort(function(a,b){return b.confidence-a.confidence;}).slice(0,policy.writeLimit);
    const applied=policy.autoApply?stage9ApplyWithRegression_(ss,deduped,runId,policy):{ok:true,applied:[],rolledBack:false,gate:{pass:true,detail:'Dry-run / auto-apply disabled'}};
    const appliedReviewIds={};(applied.applied||[]).forEach(function(change){(change.reviewIds||[]).forEach(function(id){appliedReviewIds[id]=true;});});
    let deferred=0,updated=0,noChange=0;
    outcomes.forEach(function(result){const review=result.review;if(appliedReviewIds[review.reviewId]&&!applied.rolledBack){stage9SetReviewStatus_(reviewSheet,review.row,'Data updated','Stage 9 auto-applied high-confidence official-source change(s); regression gate passed. Run '+runId+'.');updated++;}else if(result.explicitMatches&&!result.candidates.length&&policy.resolveExplicitNoChange){stage9SetReviewStatus_(reviewSheet,review.row,'Reviewed - no data change','Stage 9 found explicit managed fields on the official source and they match the master. Run '+runId+'.');noChange++;}else if(result.sourceInaccessible){stage9SetReviewStatus_(reviewSheet,review.row,'Source inaccessible','Stage 9 could not safely read the source: '+(result.reason||'unknown source error')+'.');deferred++;}else{const reason=applied.rolledBack?'Regression gate failed; all Stage 9 writes were rolled back.':(result.reason||'No green-rule change could be proven from one unambiguous official-source value.');stage9SetReviewStatus_(reviewSheet,review.row,'Deferred','Stage 9: '+reason+' Run '+runId+'.');deferred++;}});
    const notes='Stage 9 checked '+reviews.length+' review items; '+(applied.applied||[]).length+' field writes '+(applied.rolledBack?'rolled back':'committed')+'; '+updated+' reviews updated; '+deferred+' deferred; '+noChange+' no-change; '+fetchErrors+' source errors. Gate: '+(applied.gate&&applied.gate.detail||'n/a')+'.';
    stage9AppendRunLog_({job:'autonomous-maintenance',checked:reviews.length,changes:applied.rolledBack?0:(applied.applied||[]).length,errors:fetchErrors+(applied.rolledBack?1:0),reviewItems:deferred,duration:Date.now()-started,notes:notes});stage9SetDashboardStatus_('Installed',applied.rolledBack?'Guarded':'Active','Last Stage 9 run: '+stage9FormatDateTime_(new Date())+' — '+notes);
    return {ok:!applied.rolledBack,runId:runId,checked:reviews.length,applied:applied.rolledBack?0:(applied.applied||[]).length,deferred:deferred,noChange:noChange,gate:applied.gate};
  }finally{lock.releaseLock();}
}

function stage9PlanReview_(ss,review,policy){
